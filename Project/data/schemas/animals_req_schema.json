{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": ["dog", "cat", "rabbit", "small-furry", "horse", "bird", "scales-fins-other", "barnyard"],
        "description": "Return results matching animal type"
      },
      "breed": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Return results matching animal breed(s)"
      },
      "size": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["small", "medium", "large", "xlarge"]
        },
        "description": "Return results matching animal size(s)"
      },
      "gender": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["male", "female", "unknown"]
        },
        "description": "Return results matching animal gender(s)"
      },
      "age": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["baby", "young", "adult", "senior"]
        },
        "description": "Return results matching animal age(s)"
      },
      "coat": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["short", "medium", "long", "wire", "hairless", "curly"]
        },
        "description": "Return results matching animal coat(s)"
      },
      "status": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["adoptable", "adopted", "found"]
        },
        "description": "Return results matching adoption status(es)"
      },
      "organization": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Return results associated with specific organization(s)"
      }
    }
  }