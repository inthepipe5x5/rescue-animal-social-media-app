{
  "name": "Python Debugger: Flask",
  "type": "debugpy",
  "request": "launch",
  "module": "flask",
  "env": {
    "PYTHONPATH": "${workspaceFolder}/Project",
    "FLASK_APP": "Project.core.app:create_app",
    "FLASK_DEBUG": "1"
  },
  "args": ["run", "--debugger", "--reload"],
  "jinja": true,
  "justMyCode": true,
  "configurations": [
    {
      "name": "Python Debugger: Flask",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/Project",
        "FLASK_APP": "Project.core.app:create_app",
        "FLASK_DEBUG": "1",
        "FLASK_ENV": "development"
      },
      "args": ["run", "--debugger", "--reload"],
      "jinja": true,
      "autoStartBrowser": true
    },
    {
      "name": "Run Unittests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "program": "${workspaceFolder}/Project/core/app.py",
      "args": [
        "-v", // Verbose mode
        "-s",
        "${workspaceFolder}/tests", // Directory containing tests
        "-p",
        "test_*.py" // Pattern for test files
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/Project"
      },
      "jinja": true,
      "justMyCode": true
    }
  ]
}
